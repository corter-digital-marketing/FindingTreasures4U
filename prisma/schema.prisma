// Prisma schema for Finding Treasures 4 U
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  FURNISHINGS
  WEATHERVANES
  COLLECTABLES
  ARTWORKS
  JEWELRY
  CURRENCY
}

enum DeliveryMethod {
  SHIPPING
  PICKUP
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
}

model Product {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  category           Category
  priceCents         Int
  // Flat shipping charge for this piece, in cents — set directly by the
  // admin, in dollars, on the product form. Meaningless (kept at 0) when
  // needsShippingQuote is true.
  shippingCents      Int      @default(0)
  // When true: sold at checkout for the item price alone; shipping is
  // quoted and charged separately afterward (see the admin "Send Shipping
  // Quote" action and Order.needsShippingQuote). When false, shippingCents
  // above is charged automatically at checkout.
  needsShippingQuote Boolean  @default(false)
  // Hidden from the public site entirely (listings, category pages, direct
  // product URL for non-admins) until the owner flips this on. Defaults to
  // true so the normal one-at-a-time admin flow is unaffected; bulk imports
  // set this false so hundreds of items can be reviewed before going live.
  published          Boolean  @default(true)
  description        String
  condition          String?
  dimensions         String?
  featured           Boolean  @default(false)
  sold               Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  images     ProductImage[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                      String         @id @default(cuid())
  status                  OrderStatus    @default(AWAITING_PAYMENT)
  // PICKUP orders are collected in store: no shipping charge, and the address
  // fields below are stored as empty strings.
  deliveryMethod          DeliveryMethod @default(SHIPPING)
  customerName            String
  email                   String
  phone                   String?
  addressLine1            String
  addressLine2            String?
  city                    String
  region                  String
  postalCode              String
  country                 String
  notes                   String?
  shippingCents           Int            @default(0)
  // Charged amount: items subtotal plus shippingCents. Does NOT include
  // shippingQuoteCents below — that's collected as a separate charge.
  totalCents              Int
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  createdAt               DateTime       @default(now())

  // "Contact for Price" items (large/awkward-to-ship pieces) are bought at
  // checkout for the item price alone — shipping isn't known yet. When set,
  // the admin can enter a shipping cost once determined; that generates a
  // separate Stripe Checkout Session and emails the customer a payment link
  // for just that amount, tracked by the fields below.
  needsShippingQuote             Boolean   @default(false)
  shippingQuoteCents             Int?
  shippingQuoteCheckoutSessionId String?   @unique
  shippingQuoteSentAt            DateTime?
  shippingQuotePaidAt            DateTime?

  items OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  nameSnapshot String
  priceCents   Int
  quantity     Int     @default(1)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// Tracks failed admin login attempts per client IP, so brute-force guessing
// gets locked out. Lives in the database (not in-memory) because Vercel's
// serverless functions don't share memory across instances or cold starts.
model LoginAttempt {
  identifier   String    @id
  attempts     Int       @default(0)
  firstAttempt DateTime  @default(now())
  lockedUntil  DateTime?
}
