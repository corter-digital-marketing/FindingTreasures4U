// Prisma schema for Finding Treasures 4 U
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShippingTier {
  SMALL
  MEDIUM
  LARGE
  // "Really big" items: shipping can't be quoted automatically, so these are
  // not purchasable online at all — the product page shows a contact prompt
  // instead of Add to Cart, and submitOrder refuses them server-side too.
  CONTACT
}

enum Category {
  FURNISHINGS
  WEATHERVANES
  COLLECTABLES
  ARTWORKS
  JEWELRY
}

enum DeliveryMethod {
  SHIPPING
  PICKUP
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
}

model Product {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  category      Category
  priceCents    Int
  // Flat shipping charge for this piece, in cents. 0 means free shipping.
  shippingCents Int          @default(0)
  shippingTier  ShippingTier @default(SMALL)
  // Hidden from the public site entirely (listings, category pages, direct
  // product URL for non-admins) until the owner flips this on. Defaults to
  // true so the normal one-at-a-time admin flow is unaffected; bulk imports
  // set this false so hundreds of items can be reviewed before going live.
  published     Boolean      @default(true)
  description   String
  condition     String?
  dimensions    String?
  featured      Boolean      @default(false)
  sold          Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  images     ProductImage[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                      String         @id @default(cuid())
  status                  OrderStatus    @default(AWAITING_PAYMENT)
  // PICKUP orders are collected in store: no shipping charge, and the address
  // fields below are stored as empty strings.
  deliveryMethod          DeliveryMethod @default(SHIPPING)
  customerName            String
  email                   String
  phone                   String?
  addressLine1            String
  addressLine2            String?
  city                    String
  region                  String
  postalCode              String
  country                 String
  notes                   String?
  shippingCents           Int            @default(0)
  // Charged amount: items subtotal plus shippingCents.
  totalCents              Int
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  createdAt               DateTime       @default(now())

  items OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  nameSnapshot String
  priceCents   Int
  quantity     Int     @default(1)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// Tracks failed admin login attempts per client IP, so brute-force guessing
// gets locked out. Lives in the database (not in-memory) because Vercel's
// serverless functions don't share memory across instances or cold starts.
model LoginAttempt {
  identifier   String    @id
  attempts     Int       @default(0)
  firstAttempt DateTime  @default(now())
  lockedUntil  DateTime?
}
